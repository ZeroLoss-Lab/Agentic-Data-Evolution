# =============================================================================
# Environment template for ADE scripts.
# Copy to `.env` and fill in YOUR OWN endpoints and keys.
# Nothing here is committed with real values — do not hardcode credentials.
# =============================================================================

# --- D(0) construction (src/construction/generate_d0.py) --------------------
D0_MODEL="qwen"
D0_BASE_URL="https://<your-d0-endpoint>/v1"
D0_API_KEY="<your-d0-api-key>"
D0_PROMPT_LANGUAGE="zh"
D0_DISABLE_THINKING=true

# --- OVS data evolution (src/ovs/ovs.py, scripts/run_ovs.sh) ----------------
# Semicolon-separated list of user-provided OpenAI-compatible /v1 endpoints.
OVS_SERVICE_URLS="https://<your-ovs-endpoint>/v1"
# Model name registered by the endpoint.
OVS_MODEL="qwen"
OVS_API_KEY="<your-ovs-api-key>"
OVS_PROMPT_LANGUAGE="zh"
OVS_DISABLE_THINKING=true

# I/O for one OVS round (override per run).
OVS_INPUT_DIR="/path/to/init"
OVS_OUTPUT_DIR="/path/to/round1"
OVS_LOG_FILE="/path/to/ovs.log"

# Optional OVS knobs (defaults shown).
# OVS_ROUNDS=4
# OVS_CONCURRENT=1200
# OVS_REWRITE_ROUNDS=2
# OVS_TIMEOUT=720
# OVS_MAX_RETRY=3

# --- Evaluation judge (src/evaluation/eval_*.py) -----------------------------
# The paper uses DeepSeek-V3.2 as the automatic judge. Point these at your own
# judge-model endpoint and key.
JUDGE_MODEL="deepseek_v32"
JUDGE_BASE_URL="https://<your-judge-endpoint>/v1"
JUDGE_API_KEY="<your-judge-api-key>"
EVAL_PROMPT_LANGUAGE="zh"
OPENAI_DISABLE_THINKING=true

# --- Model endpoint for prediction generation (src/evaluation/llm_gen.py) ----
SERVED_MODEL_NAME="your-model-name"
SERVED_MODEL_BASE_URL="https://<your-model-endpoint>/v1"
SERVED_MODEL_API_KEY="<your-model-api-key>"

# --- Reference model for paired DEV300 evaluation ---------------------------
REFERENCE_MODEL_NAME="your-reference-model-name"
REFERENCE_MODEL_BASE_URL="https://<your-reference-endpoint>/v1"
REFERENCE_MODEL_API_KEY="<your-reference-model-api-key>"
